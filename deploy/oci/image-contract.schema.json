{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vorton.dev/schemas/oci-image-contract-v1.json",
  "title": "Vorton OCI image contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "component", "sourceCommit", "image"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "component": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
