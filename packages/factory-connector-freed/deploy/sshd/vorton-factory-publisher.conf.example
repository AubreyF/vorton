Match User vorton-factory-publisher
    AuthenticationMethods publickey
    AuthorizedKeysFile /etc/vorton-factory/ssh/publisher_authorized_keys
    ForceCommand /opt/vorton-factory/node/bin/node /opt/vorton-factory/releases/replace-with-revision/dist/cli/publisher-ssh-gateway.js /etc/vorton-factory/publisher-runtime.json /opt/vorton-factory/releases/replace-with-revision/dist/cli/publish-draft-local.js /etc/vorton-factory/ssh/publisher_authorized_keys
    DisableForwarding yes
    PermitTTY no
    X11Forwarding no
    PermitUserRC no
    PasswordAuthentication no
    KbdInteractiveAuthentication no
