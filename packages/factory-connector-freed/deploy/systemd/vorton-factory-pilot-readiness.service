[Unit]
Description=Audit FreedOS Factory pilot readiness
Requires=vorton-factory-github-token.service vorton-factory-host-gateway.service vorton-factory-planning-snapshot.service vorton-factory-freed-broker-conformance.service
After=vorton-factory-github-token.service vorton-factory-host-gateway.service vorton-factory-planning-snapshot.service vorton-factory-freed-broker-conformance.service

[Service]
Type=oneshot
User=vorton-factory-symphony
Group=vorton-factory-symphony
WorkingDirectory=/var/lib/vorton-factory/symphony
EnvironmentFile=/etc/vorton-factory/symphony.env
ExecStartPre=/opt/vorton-factory/node/bin/node /opt/vorton-factory/current/dist/cli/probe-executor-readiness.js
ExecStartPre=/opt/vorton-factory/node/bin/node /opt/vorton-factory/current/dist/cli/probe-publisher-readiness.js
ExecStartPre=/opt/vorton-factory/node/bin/node /opt/vorton-factory/current/dist/cli/collect-planning-snapshot.js
ExecStart=/opt/vorton-factory/node/bin/node /opt/vorton-factory/current/dist/cli/audit-pilot-readiness.js
StateDirectory=vorton-factory/coordinator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/vorton-factory /opt/vorton-factory /opt/freed /srv/freed /var/lib/freed/automation
ReadWritePaths=/var/lib/vorton-factory/coordinator /var/lib/freed/automation/control/.guards/tasks.lock/kernel.lock /var/lib/freed/automation/control/.guards/events.lock/kernel.lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native
