CODEX_HOME=/var/lib/vorton-factory/symphony/codex
VORTON_FACTORY_ACCOUNT_ID=codex-pro-1
VORTON_FACTORY_CODEX_EFFORT=high
VORTON_FACTORY_CODEX_EXECUTABLE=/opt/vorton-factory/bin/codex
VORTON_FACTORY_CODEX_MODEL=replace-with-advertised-callable-model
VORTON_FACTORY_CODEX_VERSION=replace-with-exact-codex-version-output
VORTON_FACTORY_HOST_GATEWAY_URL=http://127.0.0.1:8090
VORTON_FACTORY_HOST_ID=linux-control-1
VORTON_FACTORY_HOST_LANE=linux
VORTON_FACTORY_HOST_PRIVATE_KEY_FILE=/etc/vorton-factory/keys/linux-host-private.pem
VORTON_FACTORY_HOST_SEQUENCE_FILE=/var/lib/vorton-factory/symphony/host-envelope.sequence
VORTON_FACTORY_QUOTA_SAMPLE_SECONDS=60
