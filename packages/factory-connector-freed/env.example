GITHUB_REPO=freed-project/freed
GITHUB_TOKEN=replace_with_short_lived_installation_token
SYMPHONY_SSH_CONFIG=/etc/vorton-factory/ssh/config
VORTON_FACTORY_SYMPHONY_WORKSPACES=/var/lib/vorton-factory/workspaces
VORTON_FACTORY_HOST_ID=linux-control-1
VORTON_FACTORY_ACCOUNT_ID=codex-pro-1
VORTON_FACTORY_QUOTA_SAMPLE_SECONDS=60
VORTON_FACTORY_QUOTA_RESERVE_PERCENT=10
VORTON_FACTORY_CODEX_MODEL=replace_with_an_advertised_callable_model
VORTON_FACTORY_CODEX_EFFORT=high
VORTON_FACTORY_GIT_EXECUTABLE=/usr/bin/git
VORTON_FACTORY_HOST_ENROLLMENTS_FILE=/etc/vorton-factory/hosts.json
VORTON_FACTORY_ACCOUNT_PROFILES_FILE=/etc/vorton-factory/account-profiles.json
VORTON_FACTORY_HOST_WORKSPACE_ROOTS_FILE=/etc/vorton-factory/host-workspaces.json
VORTON_FACTORY_PLANNING_SNAPSHOT_FILE=/var/lib/vorton-factory/coordinator/planning-snapshot.json
VORTON_FACTORY_DISPATCH_INTENTION_FILE=/var/lib/vorton-factory/coordinator/dispatch-intention.json
VORTON_FACTORY_CLAIM_RECONCILIATION_FILE=/var/lib/vorton-factory/admission/claim-reconciliation.json
VORTON_FACTORY_FREED_REPOSITORY_ROOT=/srv/freed
VORTON_FACTORY_FREED_CLAIM_BROKER=/opt/freed/bin/factory-coordinator
VORTON_FACTORY_CHECKPOINT_EDGE_URL=http://127.0.0.1:8091
VORTON_FACTORY_CHECKPOINT_LOCAL_STORE_ROOT=/var/lib/vorton-factory/checkpoints
VORTON_FACTORY_CHECKPOINT_KEY_FILE=/var/lib/vorton-factory/identity/checkpoint-key.bin
VORTON_FACTORY_CHECKPOINT_KEY_REFERENCE=pilot:checkpoint-v1
FREED_REPOSITORY_ROOT=/srv/vorton-factory/repositories/freed
FREED_AUTOMATION_STATE_ROOT=/srv/vorton-factory/state/freed/automation
VORTON_FACTORY_WORKTREE_ROOT=/var/lib/vorton-factory/workspaces
VORTON_FACTORY_WORKTREE_HELPER=/srv/vorton-factory/repositories/freed/scripts/worktree-add.sh
CODEX_HOME=/var/lib/vorton-factory/symphony/codex
