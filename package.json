{
  "name": "vorton-local",
  "version": "0.2.0-preview.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node scripts/demo.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
