{
  "name": "aubos",
  "version": "0.0.0",
  "private": true,
  "description": "A reusable operating system for people and organizations.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "examples/tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "release:validate": "tsx release/validate-manifest.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
