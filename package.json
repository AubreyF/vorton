{
  "name": "vorton",
  "version": "0.0.0",
  "private": true,
  "description": "A reusable operating system for people and organizations.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "examples/tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "bootstrap:apply": "tsx deploy/bootstrap/provision.ts --apply",
    "bootstrap:plan": "tsx deploy/bootstrap/provision.ts --plan",
    "bootstrap:test": "vitest run deploy/bootstrap/*.test.ts",
    "bootstrap:typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck deploy/bootstrap/provision.ts deploy/bootstrap/provision.test.ts",
    "check": "npm run typecheck && npm run bootstrap:typecheck && npm run workspace:add:typecheck && npm run test && npm run bootstrap:test && npm run workspace:add:test && npm run runtime:test && npm run release:test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "release:prepare": "tsx release/prepare-release.ts",
    "release:normalize-sbom": "tsx release/preflight-release.ts --normalize-sbom",
    "release:preflight": "tsx release/preflight-release.ts",
    "release:test": "vitest run release/*.test.ts",
    "release:validate": "tsx release/validate-manifest.ts",
    "runtime:test": "vitest run deploy/fly/runtime/*.test.ts",
    "runtime:hindsight-canary": "tsx deploy/fly/runtime/hindsight-canary.ts",
    "runtime:validate-env": "tsx deploy/fly/runtime/validate-environment.ts",
    "security:secrets": "test \"$(gitleaks version)\" = \"8.30.1\" && gitleaks git --redact=100 --no-banner .",
    "workspace:add:apply": "tsx deploy/workspaces/add-workspace.ts --apply",
    "workspace:add:aubos:apply": "tsx deploy/workspaces/add-aubos-workspace.ts --apply",
    "workspace:add:aubos:plan": "tsx deploy/workspaces/add-aubos-workspace.ts --plan",
    "workspace:add:plan": "tsx deploy/workspaces/add-workspace.ts --plan",
    "workspace:add:test": "vitest run deploy/workspaces/*.test.ts",
    "workspace:add:typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck deploy/workspaces/add-workspace.ts deploy/workspaces/add-aubos-workspace.ts deploy/workspaces/add-workspace.test.ts",
    "test:postgres-authority": "tsx scripts/postgres-authority-test.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "esbuild": "0.28.2",
    "prettier": "^3.5.3",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
