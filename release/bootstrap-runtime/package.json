{
  "name": "@vorton/release-bootstrap-runtime",
  "version": "0.4.0",
  "private": true,
  "description": "Dependency-locked runtime for an extracted Vorton release bootstrap.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vorton": "node bin/vorton.cjs",
    "bootstrap:apply": "tsx deploy/bootstrap/provision.ts --apply",
    "bootstrap:plan": "tsx deploy/bootstrap/provision.ts --plan",
    "runtime:hindsight-canary": "node bin/hindsight-canary.cjs"
  },
  "dependencies": {
    "pg": "8.23.0",
    "tsx": "4.23.12"
  }
}
